# ============================================================
# DESAFIO CIEE - Variáveis de ambiente
# ============================================================
# Copie este arquivo como .env e preencha os valores reais.
# O arquivo .env NÃO deve ser commitado (já está no .gitignore).
# ============================================================

# -----------------------------
# SQL Server
# -----------------------------
# Senha do usuário SA (mínimo 8 caracteres: letras maiúsculas, minúsculas, números e/ou símbolos)
SA_PASSWORD=SuaSenhaForte@123

# Porta mapeada no host para o SQL Server
SQL_PORT=1433

# Nome do banco de dados
SQL_DATABASE=DesafioCIEE_Curriculos

# -----------------------------
# API ASP.NET Core
# -----------------------------
# Porta mapeada no host para a API
API_PORT=5000

# Connection String que a API usa para conectar no SQL Server
# (o host 'sqlserver' é o nome do serviço definido no docker-compose.yml)
CONNECTION_STRING=Server=sqlserver,1433;Database=${SQL_DATABASE};User Id=sa;Password=${SA_PASSWORD};TrustServerCertificate=True;

# Origens permitidas no CORS (URL onde o frontend será acessado)
CORS_ORIGIN=http://localhost:8080

# -----------------------------
# Frontend (Nginx)
# -----------------------------
# Porta mapeada no host para o frontend
FRONT_PORT=8080
